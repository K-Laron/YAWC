[Unit]
Description=YAWC pill overlay — bottom center Wispr-like
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/bash -c 'LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so python3 -u %h/.local/share/yawc/src/pill_overlay.py'
Restart=on-failure
RestartSec=1
Environment=WAYLAND_DISPLAY=wayland-1

[Install]
WantedBy=default.target
