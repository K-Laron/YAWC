[Unit]
Description=YAWC Right Alt hold via evdev — Wispr-like single key
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/yawc
ExecStart=/usr/bin/python3 -u %h/.local/share/yawc/src/evdev_hold.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
