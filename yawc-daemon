#!/usr/bin/env bash
# ponytail: YAWC daemon — hold→release toggles, STT→LLM→paste + pill per 01/02/03/04/05/08
set -euo pipefail
# ensure pill overlay on any app (niri layer OVERLAY top 20) — autostart if not running
if ! pgrep -f pill_overlay.py >/dev/null 2>&1; then
  LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so nohup python3 "$(dirname "$0")/src/pill_overlay.py" >/tmp/yawc-pill.log 2>&1 &
  sleep 0.3
fi
CMD="${1:-help}"
case "$CMD" in
  toggle) exec "$(dirname "$0")/prototype/03-niri-injection/scripts/yawc-hold-release.sh" ;;
  hold)   exec "$(dirname "$0")/prototype/03-niri-injection/scripts/yawc-trigger.sh" ;;
  pill) exec python3 "$(dirname "$0")/src/pill_overlay.py" ;;
  dictate) python3 -c "from src.dictation import Dictation,Utterance; d=Dictation(['Priya','kamag-anak'],{}); print(d.dictate(Utterance(wav_path='${2:-/tmp/live.wav}')))" ;;
  command) echo "[yawc] command mode Ctrl+Win+Alt hold — selection via wl-paste -p (see 05)";;
  transform) echo "[yawc] transform $2 on selection — llama.cpp Qwen3-1.7B c512 (see 05/08)";;
  *) echo "yawc-daemon {toggle|hold|pill|dictate|command|transform} — pill shows on any app (niri OVERLAY)";;
esac
